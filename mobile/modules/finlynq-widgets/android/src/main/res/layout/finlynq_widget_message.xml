<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/finlynq_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/finlynq_widget_background"
  android:orientation="vertical"
  android:padding="12dp">

  <TextView
    android:id="@+id/finlynq_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="@color/finlynq_widget_muted"
    android:textSize="12sp" />

  <TextView
    android:id="@+id/finlynq_message"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center"
    android:text="@string/finlynq_widget_loading"
    android:textColor="@color/finlynq_widget_fg"
    android:textSize="13sp" />
</LinearLayout>
