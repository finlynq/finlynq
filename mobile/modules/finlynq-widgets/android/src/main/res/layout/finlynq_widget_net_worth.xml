<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/finlynq_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/finlynq_widget_background"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:paddingHorizontal="14dp"
  android:paddingVertical="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/finlynq_widget_net_worth_name"
      android:textColor="@color/finlynq_widget_muted"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/finlynq_stale"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:maxLines="1"
      android:textColor="@color/finlynq_widget_muted"
      android:textSize="10sp"
      android:visibility="gone" />
  </LinearLayout>

  <TextView
    android:id="@+id/finlynq_amount"
    android:layout_width="match_parent"
    android:layout_height="34dp"
    android:autoSizeMaxTextSize="26sp"
    android:autoSizeMinTextSize="14sp"
    android:autoSizeStepGranularity="1sp"
    android:autoSizeTextType="uniform"
    android:gravity="center_vertical"
    android:maxLines="1"
    android:textColor="@color/finlynq_widget_fg"
    android:textStyle="bold" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/finlynq_widget_assets"
        android:textColor="@color/finlynq_widget_muted"
        android:textSize="11sp" />

      <TextView
        android:id="@+id/finlynq_assets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/finlynq_widget_pos"
        android:textSize="13sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/finlynq_widget_debts"
        android:textColor="@color/finlynq_widget_muted"
        android:textSize="11sp" />

      <TextView
        android:id="@+id/finlynq_debts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/finlynq_widget_neg"
        android:textSize="13sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
