<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/finlynq_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/finlynq_widget_background"
  android:orientation="vertical"
  android:paddingHorizontal="14dp"
  android:paddingVertical="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/finlynq_widget_upcoming_name"
      android:textColor="@color/finlynq_widget_muted"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/finlynq_stale"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:maxLines="1"
      android:textColor="@color/finlynq_widget_muted"
      android:textSize="10sp"
      android:visibility="gone" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/finlynq_rows"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" />
</LinearLayout>
