<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/finlynq_row"
  android:layout_width="match_parent"
  android:layout_height="27dp"
  android:gravity="center_vertical"
  android:orientation="horizontal">

  <TextView
    android:id="@+id/finlynq_row_when"
    android:layout_width="62dp"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="@color/finlynq_widget_muted"
    android:textSize="11sp" />

  <TextView
    android:id="@+id/finlynq_row_name"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="@color/finlynq_widget_fg"
    android:textSize="13sp" />

  <TextView
    android:id="@+id/finlynq_row_amount"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:maxLines="1"
    android:textColor="@color/finlynq_widget_fg"
    android:textSize="13sp"
    android:textStyle="bold" />
</LinearLayout>
